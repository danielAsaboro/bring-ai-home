{
  "name": "bring-ai-home-companion",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.15.0",
    "npm": "11.12.1"
  },
  "scripts": {
    "check": "tsc --noEmit",
    "test": "node --import tsx --test test/**/*.test.ts",
    "fixture:audio": "tsx scripts/make-audio-fixture.ts",
    "ep01": "QVAC_WORKER_PATH=qvac/worker.entry.mjs tsx src/episodes/01-first-model.ts",
    "ep03": "tsx src/episodes/03-model-anatomy.ts",
    "ep04": "QVAC_WORKER_PATH=qvac/worker.memory.mjs tsx src/episodes/04-memory.ts",
    "ep05": "npm run ep05:transcribe && npm run ep05:index",
    "ep05:transcribe": "QVAC_WORKER_PATH=qvac/worker.speech.mjs tsx src/episodes/05-senses.ts",
    "ep05:index": "QVAC_WORKER_PATH=qvac/worker.memory.mjs tsx src/episodes/05-index-transcript.ts",
    "ep06": "QVAC_WORKER_PATH=qvac/worker.entry.mjs tsx src/episodes/06-agent.ts",
    "ep07:provider": "QVAC_WORKER_PATH=qvac/worker.entry.mjs tsx src/episodes/07-provider.ts",
    "ep07:consumer": "QVAC_WORKER_PATH=qvac/worker.entry.mjs tsx src/episodes/07-consumer.ts",
    "ep08": "npm run ep08:retrieve && npm run ep08:answer",
    "ep08:retrieve": "QVAC_WORKER_PATH=qvac/worker.memory.mjs tsx src/episodes/08-retrieve.ts",
    "ep08:answer": "QVAC_WORKER_PATH=qvac/worker.entry.mjs tsx src/episodes/08-assistant.ts"
  },
  "dependencies": {
    "@qvac/sdk": "0.16.0",
    "zod": "4.1.12"
  },
  "devDependencies": {
    "@types/node": "24.10.1",
    "tsx": "4.20.6",
    "typescript": "5.9.3"
  }
}

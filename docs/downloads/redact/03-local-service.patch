+import type {
+  AnalyzePageRequest,
+  AnalysisResponse,
+} from "../src/features/redact/analysis-contract";
+
+export type AnalyzerState = {
+  service: "ready" | "error";
+  models: Array<{
+    kind: "ocr" | "reasoning";
+    id: string;
+    state: "not_loaded" | "loading" | "ready" | "error";
+  }>;
+};

@@ -0,0 +1,79 @@
+// @vitest-environment node
+
+import { describe, expect, it, vi } from "vitest";
+
+import { createDecisionReasoner, decisionQuestions, type DecisionRuntime } from "./decision-reasoner";
+
+const bbox = [0, 0, 10, 10] as [number, number, number, number];
+const blocks = [
+  { text: "Maya Chen", bbox, confidence: 0.93 },
+  { text: "phone is +1 415 555 0184.", bbox, confidence: 0.68 },
+  { text: "Got it.", bbox, confidence: 0.98 },
+  { text: "and reference APOLLO-4471", bbox, confidence: 0.69 },
+];
+
+function runtimeFor(answers: Array<Record<string, number>>): DecisionRuntime {
+  return {
+    loadModel: vi.fn(async () => "decision-model-1"),
+    decide: vi.fn(async () =>
+      answers.map((byQuestion) => ({
+        answers: Object.fromEntries(Object.entries(byQuestion).map(([id, noul]) => [id, { noul }])),
+      })),
+    ),
+    unloadModel: vi.fn(async () => undefined),
+  };
+}
+
+describe("local decision reasoning", () => {
+  it("asks one yes/no question per field and adds the user's direction", () => {
+    expect(Object.keys(decisionQuestions("private", ""))).toEqual([
+      "name", "email", "phone", "address", "account", "identity",
+    ]);
+    const confidential = decisionQuestions("confidential", " Hide Apollo references ");
+    expect(Object.keys(confidential)).toContain("reference");
+    expect(confidential.direction).toEqual({
+      type: "noul",
+      instructions: "This text is something the user asked to hide: Hide Apollo references",
+    });
+  });
+
+  it("keeps the most likely field above the threshold and grounds its label", async () => {
+    const runtime = runtimeFor([
+      { name: 0.85, phone: 0.01 },
+      { name: 0.14, phone: 1, account: 0.73 },
+      { name: 0.05, phone: 0.09 },
+      { name: 0.09, account: 0.82, direction: 0.9 },
+    ]);
+    const reasoner = createDecisionReasoner({
+      runtime,
+      modelSource: {},
+      now: vi.fn().mockReturnValueOnce(1000).mockReturnValueOnce(1700),
+    });
+
+    const result = await reasoner.classify({
+      documentId: "document-1",
+      level: "private",
+      direction: "reference codes",
+      blocks,
+    });
+
+    expect(result.reasoningMs).toBe(700);
+    expect(result.candidates).toEqual([
+      expect.objectContaining({ blockIndex: 0, label: "name", confidence: 0.85 }),
+      expect.objectContaining({ blockIndex: 1, label: "phone", confidence: 1 }),
+      expect.objectContaining({ blockIndex: 3, label: "reference", confidence: 0.9 }),
+    ]);
+    expect(vi.mocked(runtime.decide).mock.calls[0][0]).toMatchObject({
+      modelId: "decision-model-1",
+      states: blocks.map((block) => block.text),
+    });
+    expect(reasoner.getState()).toEqual({ id: "laya-421m-q8", state: "ready" });
+  });
+
+  it("rejects a result count that doesn't match the blocks", async () => {
+    const reasoner = createDecisionReasoner({ runtime: runtimeFor([{ name: 0.9 }]), modelSource: {} });
+    await expect(
+      reasoner.classify({ documentId: "d", level: "private", direction: "", blocks }),
+    ).rejects.toThrow("did not match");
+  });
+});
diff --git a/redact/qvac-service/decision-reasoner.ts b/redact/qvac-service/decision-reasoner.ts
new file mode 100644
index 0000000..d61c1d8
--- /dev/null
+++ b/redact/qvac-service/decision-reasoner.ts
@@ -0,0 +1,125 @@
+import type { CandidateSuggestion } from "../src/features/redact/analysis-contract";
+import { validateCandidateForEvidence } from "./candidate-validation";
+import type { DocumentReasoner } from "./reasoning";
+
+type NoulQuestion = { type: "noul"; instructions: string };
+
+export type DecisionRuntime = {
+  loadModel(options: {
+    modelSrc: unknown;
+    modelType: "llamacpp-decision";
+    modelConfig: { device: "gpu" | "cpu" };
+  }): Promise<string>;
+  decide(options: {
+    modelId: string;
+    states: string[];
+    questions: Record<string, NoulQuestion>;
+  }): Promise<Array<{ answers: Record<string, { noul?: number }> }>>;
+  unloadModel(options: { modelId: string; clearStorage: boolean }): Promise<unknown>;
+};
+
+export const DECISION_THRESHOLD = 0.5;
+
+const privateQuestions = {
+  name: "This text contains a person's name.",
+  email: "This text contains an email address.",
+  phone: "This text contains a telephone number.",
+  address: "This text contains a street address.",
+  account: "This text contains a bank, card or account number.",
+  identity: "This text contains a passport, national ID or employee ID number.",
+} as const;
+
+const confidentialQuestions = {
+  ...privateQuestions,
+  amount: "This text contains a specific amount of money.",
+  date: "This text contains a sensitive date such as a birth date.",
+  reference: "This text contains a tracking, case or project reference code.",
+  business: "This text contains a private company detail.",
+} as const;
+
+type FieldLabel = keyof typeof confidentialQuestions;
+
+export function decisionQuestions(level: "private" | "confidential", direction: string) {
+  const fields = level === "confidential" ? confidentialQuestions : privateQuestions;
+  const questions: Record<string, NoulQuestion> = Object.fromEntries(
+    Object.entries(fields).map(([id, instructions]) => [id, { type: "noul", instructions }]),
+  );
+  if (direction.trim()) {
+    questions.direction = {
+      type: "noul",
+      instructions: `This text is something the user asked to hide: ${direction.trim()}`,
+    };
+  }
+  return questions;
+}
+
+export function createDecisionReasoner(options: {
+  runtime: DecisionRuntime;
+  modelSource: unknown;
+  now?: () => number;
+}): DocumentReasoner {
+  let modelId: string | null = null;
+  let loading: Promise<string> | null = null;
+  let failed = false;
+  const now = options.now ?? Date.now;
+
+  async function ensureModel() {
+    if (modelId) return modelId;
+    loading ??= options.runtime.loadModel({
+      modelSrc: options.modelSource,
+      modelType: "llamacpp-decision",
+      modelConfig: { device: "gpu" },
+    });
+    try {
+      modelId = await loading;
+      failed = false;
+      return modelId;
+    } catch (error) {
+      loading = null;
+      failed = true;
+      throw error;
+    }
+  }
+
+  return {
+    getState: () => ({
+      id: "laya-421m-q8",
+      state: failed ? "error" : modelId ? "ready" : loading ? "loading" : "not_loaded",
+    }),
+    async classify(input) {
+      const started = now();
+      if (input.blocks.length === 0) return { candidates: [], reasoningMs: 0 };
+      const loadedModelId = await ensureModel();
+      const questions = decisionQuestions(input.level, input.direction);
+      const results = await options.runtime.decide({
+        modelId: loadedModelId,
+        states: input.blocks.map((block) => block.text),
+        questions,
+      });
+      if (results.length !== input.blocks.length) {
+        throw new Error("Local decisions did not match the OCR blocks");
+      }
+      const candidates = results.flatMap((result, blockIndex) => {
+        const [question, probability] = Object.keys(questions)
+          .map((id) => [id, result.answers[id]?.noul ?? 0] as const)
+          .reduce((best, entry) => (entry[1] > best[1] ? entry : best));
+        if (probability < DECISION_THRESHOLD) return [];
+        const proposed: CandidateSuggestion = {
+          blockIndex,
+          label: question === "direction" ? "other" : (question as FieldLabel),
+          explanation: "Proposed by local decisions.",
+          confidence: probability,
+        };
+        const validated = validateCandidateForEvidence(proposed, input.blocks[blockIndex].text);
+        return validated ? [validated] : [];
+      });
+      return { candidates, reasoningMs: now() - started };
+    },
+    async close() {
+      if (modelId) {
+        await options.runtime.unloadModel({ modelId, clearStorage: false });
+        modelId = null;
+      }
+    },
+  };
+}
